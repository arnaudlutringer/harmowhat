# Classement mondial (Supabase) : copier ce fichier en « .env » et remplir les deux valeurs,
# trouvées dans Supabase → Project Settings → API (Project URL et clé « anon public »).
# La clé anon est publique par conception (elle est dans l'appli) : les règles d'accès de
# supabase/schema.sql limitent ce qu'elle permet (lire et ajouter des scores, rien d'autre).
# Sans ces valeurs, l'appli n'affiche que les scores de l'appareil.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
